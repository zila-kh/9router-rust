# 9Router Rust Backend Configuration

# Server host and listening port
NINEROUTER_HOST=127.0.0.1
PORT=20128

# Frontend UI integration (Rust proxies / dashboard requests to Next.js)
NINEROUTER_UI_ORIGIN=http://127.0.0.1:20129
NINEROUTER_UI_ONLY=1

# Storage paths
# NINEROUTER_DATA_DIR=
# NINEROUTER_DB_PATH=

# Upstream timeouts
NINEROUTER_UPSTREAM_TIMEOUT_SECS=120

# Upstream proxy settings (optional)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
